generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  role         String           @default("user")
  score        Int              @default(0)
  enrollments  UserEnrollment[]
  badges       UserBadge[]
}

model Badge {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  icon        String           
  users       UserBadge[]      
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId]) 
}

model Roadmap {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  isPremium   Boolean          @default(false)
  steps       Step[]           @relation("RoadmapSteps")
  
  enrollments UserEnrollment[]
}

model Step {
  id            Int     @id @default(autoincrement())
  title         String
  description   String?  
  content       String?  
  notes         String?  
  isFinished    Boolean @default(false)
  resourcesName String?  
  resoursesLink String?  
  roadmapId     Int
  roadmap       Roadmap  @relation("RoadmapSteps", fields: [roadmapId], references: [id], onDelete: Cascade)
}

model UserEnrollment {
  id                Int                  @id @default(autoincrement())
  userId            Int
  roadmapId         Int
  status            String               @default("in-progress")
  progress          Int                  @default(0) 
  completedSteps    Json                 @default("[]") 
  enrolledAt        DateTime             @default(now())
  
  submittedProjects ProjectSubmission[]

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap           Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model ProjectSubmission {
  id             Int            @id @default(autoincrement())
  enrollmentId   Int            
  projectTitle   String         
  projectUrl     String         
  status         String         @default("pending") 
  submittedAt    DateTime       @default(now())

  enrollment     UserEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}