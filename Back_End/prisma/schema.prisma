generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  role         String           @default("user")
  enrollments  UserEnrollment[]
}

model Roadmap {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  isPremium   Boolean          @default(false)
  steps       Step[]           @relation("RoadmapSteps")
  enrollments UserEnrollment[]
}

model Step {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  
  content     String?  
  notes       String?  
  isFinished  Boolean  @default(false)
  roadmapId   Int
  roadmap     Roadmap  @relation("RoadmapSteps", fields: [roadmapId], references: [id], onDelete: Cascade)
}

model UserEnrollment {
  id                Int                  @id @default(autoincrement())
  userId            Int
  roadmapId         Int
  status            String               @default("in-progress")
  progress          Int                  @default(0) 
  completedSteps    Json                 @default("[]") 
  enrolledAt        DateTime             @default(now())
  
  submittedProjects ProjectSubmission[]

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap           Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model ProjectSubmission {
  id             Int            @id @default(autoincrement())
  enrollmentId   Int            
  projectTitle   String         
  projectUrl     String         
  status         String         @default("pending") 
  submittedAt    DateTime       @default(now())

  enrollment     UserEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}